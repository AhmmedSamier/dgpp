 // Confidence is replicated across ranks and lambda is a scalar the caller keeps
 // identical on every rank, so all ranks derive the same k.
 #include <cmath>
+#include <limits>
+#include <span>
 #include <vector>
 
 namespace dgpp {
@@ -123,4 +125,39 @@ inline int scheduled_verify_depth_batch(const float* const* conf_logit, int slot
   return k;
 }
 
+// A graph budget can leave holes in the available depths. Evaluate the
+// throughput objective at the depths we can actually replay: rounding an
+// unconstrained optimum up can add an expensive, low-survival position.
+// The fixed cost and mandatory target row are common to every choice.
+// Mean survival preserves the batched objective's scale; ascending options
+// and strict improvement choose the shallower option on an exact tie.
+inline int scheduled_verify_depth_options(const float* const* conf_logit, int slots,
+                                         std::span<const int> options, float row_ms,
+                                         float lambda_tok_per_ms) {
+  if (slots <= 0 || options.empty()) return 0;
+  const double threshold = static_cast<double>(lambda_tok_per_ms) * row_ms;
+  std::vector<double> survival(static_cast<size_t>(slots), 1.0);
+  double score = 0.0;
+  double best = -std::numeric_limits<double>::infinity();
+  int depth = options.front();
+  size_t option = 0;
+  for (int i = 1; i <= options.back(); ++i) {
+    double sum = 0.0;
+    for (int s = 0; s < slots; ++s) {
+      survival[static_cast<size_t>(s)] *=
+          1.0 / (1.0 + std::exp(-static_cast<double>(conf_logit[s][i - 1])));
+      sum += survival[static_cast<size_t>(s)];
+    }
+    score += sum / slots - threshold;
+    if (i == options[option]) {
+      if (score > best) {
+        best = score;
+        depth = i;
+      }
+      ++option;
+    }
+  }
+  return depth;
+}
+
 }  // namespace dgpp
