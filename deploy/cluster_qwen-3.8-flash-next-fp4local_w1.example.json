{
  "model": "nvidia/Qwen3.8-Flash-Next-FP4-Local",
  "world_size": 1,
  "engine": {
    "max_concurrency": 4,
    "kv_capacity": 262144,
    "kv_dtype": "fp8",
    "bf16_weights": "bf12+bf16",
