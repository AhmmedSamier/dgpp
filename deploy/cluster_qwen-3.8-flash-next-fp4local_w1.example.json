    "model_alias": "Qwen3.8-Flash-Next-FP4",
    "sampling_candidates": 128,
    "stats_interval_s": 1,
    "dense_weights": "fp8",
    "fp8_head": "mma",
    "prefill_attention": "fp8"
  },
  "paths": {
    "resident_cache": ""
  },
  "http": {
    "bind_host": "0.0.0.0",
    "port": 8000
  }
