{
  "model": "nvidia/Qwen3.8-Flash-Next-NVFP4",
  "nodes": [
    "192.0.2.11"
  ],
  "ssh_user": "",
  "ports": {
    "http": 18080,
    "fabric": 29970,
    "journal": 29971
  },
  "engine": {
    "max_concurrency": 4,
    "kv_capacity": 65536,
    "kv_dtype": "bf16",
    "ngram_table": "mmap",
    "default_max_tokens": 256,
    "queue_limit": 8,
    "max_connections": 64,
    "decode_graph": true,
    "mtp": true,
    "mtp_depth": 1,
    "prefix_cache_gib": 1.5,
    "admission": "full",
    "admission_window": 256,
    "sampling_candidates": 128,
    "stats_interval_s": 10,
    "dense_weights": "fp8"
  },
  "paths": {
    "log_dir": "~/dgpp/log",
    "stage_dir": "/tmp/dgpp-stage",
    "release_dir": "~/dgpp/releases",
    "resident_cache": ""
  }
}
