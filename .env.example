# Copy these site settings into .env. Preserve any credentials already there.
# Values are literal: no shell commands or ${VARIABLE} expansion.
# Exported environment variables override this file. DGPP_ENV_FILE selects
# another file; otherwise scripts find .env at the repository/release root.

# Rank order: each deployment uses the first world_size nodes.
DGPP_NODES="192.0.2.11 192.0.2.12 192.0.2.13 192.0.2.14"
DGPP_SSH_USER=""

DGPP_HTTP_PORT=18080
DGPP_HTTP_BIND=127.0.0.1
DGPP_FABRIC_PORT=29970
DGPP_JOURNAL_PORT=29971
DGPP_LOG_DIR="~/dgpp/log"
DGPP_STAGE_DIR="/tmp/bus4"
DGPP_RELEASE_DIR="~/dgpp/releases"

# Optional default deployment; relative paths are based at the repository root.
# DGPP_CLUSTER_CONFIG="deploy/cluster.json"

# Deployment http.bind_host and http.port override the HTTP defaults above.
# Set DGPP_NODES="127.0.0.1" for a single-node deployment.
# Build and dataset paths may be relative to the repository root.
# DGPP_BUILD_DIR="build-ci"
# DGPP_DATA_DIR="data"

# Optional cache paths. ~/ expands separately on each node.
# HF_HOME="~/.cache/huggingface"
# HF_HUB_CACHE="~/.cache/huggingface/hub"
# DGPP_RESIDENT_CACHE_DIR="~/dgpp/resident-cache"

# Multi-node only: omit devices to discover active Ethernet RDMA devices.
# Use the same lane order and lane count on every node. Names may differ.
# DGPP_ROCE_DEVICES="mlx5_0 mlx5_1"
# Optional explicit GID indices, one per device; otherwise auto-select RoCE v2.
# DGPP_ROCE_GID_INDICES="3 3"
# Per-node overrides use the exact address/name from DGPP_NODES.
# DGPP_NODE_OVERRIDES='{"192.0.2.12":{"DGPP_ROCE_DEVICES":"mlx5_2 mlx5_3","HF_HUB_CACHE":"/srv/models/hub"}}'
